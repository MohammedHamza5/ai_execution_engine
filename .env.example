# Local PostgreSQL Database
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5432/ai_execution_engine

# --- Tier 1 & 2 Core Free Providers ---
# 1. Google Gemini API (https://aistudio.google.com/app/apikey)
GEMINI_API_KEY=your_gemini_api_key_here

# 2. Cloudflare Workers AI (https://dash.cloudflare.com/)
CLOUDFLARE_ACCOUNT_ID=your_account_id_here
CLOUDFLARE_API_TOKEN=your_api_token_here

# 3. OpenRouter (https://openrouter.ai/keys)
OPENROUTER_API_KEY=sk-or-v1-your_openrouter_api_key_here

# 4. GroqCloud (https://console.groq.com/keys)
GROQ_API_KEY=gsk_your_groq_api_key_here
